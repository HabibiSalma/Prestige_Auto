APP_NAME="Prestige Auto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — local MySQL 8 instance
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prestige_auto
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Filesystem & sessions
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=public
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Sanctum
# ---------------------------------------------------------------------------
# IMPORTANT: leave SANCTUM_STATEFUL_DOMAINS EMPTY. The React SPA uses pure
# bearer-token auth (Authorization header), not session cookies, so we do
# not want Sanctum to treat /api requests from localhost:5173 as "stateful"
# (that would require a CSRF token and break /login / /register).
SANCTUM_STATEFUL_DOMAINS=

# ---------------------------------------------------------------------------
# Mail — printed to laravel.log in local mode (no SMTP setup required)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@prestige-auto.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Front-end URL (used in some emails or redirects)
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
