# =============================================================================
# Prestige Auto — PRODUCTION environment (Render)
# Copy each of these as environment variables in the Render dashboard.
# Do NOT commit real secrets; this file only documents the keys.
# =============================================================================

APP_NAME="Prestige Auto"
APP_ENV=production
# Generate locally with:  php artisan key:generate --show
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
# The PUBLIC URL of THIS Render service (drives Storage::url + storage links).
APP_URL=https://prestige-auto-api.onrender.com

# Stream logs to Render's log viewer (the local log file is ephemeral).
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database — Render PostgreSQL.
# Paste the "Internal Database URL" from your Render Postgres instance.
# (Internal URL = same-region, no SSL config needed.)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@dpg-xxxx-a/prestige_auto

# ---------------------------------------------------------------------------
# Sessions / cache / queue — no extra infra required.
#   session=cookie  -> no sessions table needed (we use bearer tokens anyway)
#   cache=database  -> uses the migrated cache table
#   queue=sync      -> notifications run inline; no worker process
# ---------------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Stays empty: the React SPA uses pure Sanctum bearer-token auth (no cookies).
SANCTUM_STATEFUL_DOMAINS=

# Uploads & filesystem
FILESYSTEM_DISK=public
# Cloudinary — persistent media storage (avatars / vehicle photos / documents).
# Copy the "API environment variable" from your Cloudinary dashboard.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://123456789:abcdefg@your-cloud-name

# CORS / frontend — the deployed Vercel URL (no trailing slash).
FRONTEND_URL=https://prestige-auto.vercel.app

# Mail — log driver avoids needing an SMTP provider.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@prestige-auto.test"
MAIL_FROM_NAME="${APP_NAME}"

# Set to true for the FIRST deploy only to seed demo data, then DELETE it.
RUN_SEED=true
