# Base URL of the Laravel API, INCLUDING the /api suffix and NO trailing slash.
#
# Local dev (leave unset to use the built-in fallback http://localhost:8000/api):
# VITE_API_URL=http://localhost:8000/api
#
# Production (set this in the Vercel dashboard, not in the repo):
# VITE_API_URL=https://prestige-auto-api.onrender.com/api
VITE_API_URL=http://localhost:8000/api
